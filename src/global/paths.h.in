#pragma once

#include <string>

#include "global/runtime_paths.h"

// Source checkout configured by CMake: the development fallback for game
// data. Packaged builds resolve their installed copy at runtime instead.
constexpr const char *FM_SOURCE_DIR = "@PROJECT_SOURCE_DIR@/";

/**
 * Read-only game data under RuntimePaths::assetRoot() (installed data next to
 * the executable, else the source checkout). Writable files (saves, settings,
 * logs) live under RuntimePaths::root() instead.
 */
namespace AssetPaths
{
/** Directory containing assets/, with a trailing separator. */
inline std::string root() { return (RuntimePaths::assetRoot() / "").string(); }
inline std::string file(const char *relative)
{
  return (RuntimePaths::assetRoot() / relative).string();
}

inline std::string statsConfig() { return file("assets/config/stats_config.json"); }

// User made data
inline std::string leagues() { return file("assets/user_made_data/leagues/leagues.json"); }
inline std::string teamsDir() { return file("assets/user_made_data/teams/"); }
inline std::string playersDir() { return file("assets/user_made_data/players/"); }
inline std::string firstNames() { return file("assets/user_made_data/names_files/first_names.json"); }
inline std::string lastNames() { return file("assets/user_made_data/names_files/last_names.json"); }

// Database assets
inline std::string schema() { return file("assets/db/schema.sql"); }
inline std::string queries() { return file("assets/db/queries.sql"); }

// Fonts and languages
inline std::string font() { return file("assets/fonts/font.ttf"); }
inline std::string language(const std::string &name)
{
  return (RuntimePaths::assetRoot() / "assets" / "lang" / (name + ".json")).string();
}
}  // namespace AssetPaths
